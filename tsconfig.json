{
    "include": ["src"],
    "compilerOptions": {
        "strict": true,
        "target": "es2019",
        "module": "esnext",
        "moduleResolution": "bundler",
        "lib": ["dom", "dom.iterable", "esnext"],
        "types": ["node"],
        "importHelpers": true,
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "forceConsistentCasingInFileNames": true,
        "sourceMap": true
    }
}
