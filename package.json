{
  "name": "csp-with-ts",
  "version": "0.6.9",
  "scripts": {
    "clean": "rm -rf lib",
    "build": "npm run clean && rollup -c",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:types": "tsc --noEmit -p tsconfig.test.json",
    "test:mem": "vitest run --project memory",
    "bench": "vitest bench --run",
    "specs": "node scripts/spec-ledger.mjs",
    "signoff": "node scripts/spec-ledger.mjs --signoff",
    "test:drivers": "for d in immediate messagechannel timeout microtask; do echo \"== $d\"; CSP_SCHEDULER=$d vitest run --project unit || exit 1; done"
  },
  "main": "lib/index.js",
  "files": [
    "lib"
  ],
  "types": "lib",
  "author": "Shounak Bhattacharya <shounakbhattacharya89@gmail.com>",
  "license": "GPL-3.0",
  "homepage": "https://github.com/owner/project#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/speakwithalisp/csp-with-ts.git"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@types/node": "^22.0.0",
    "@types/ramda": "^0.32.0",
    "fast-check": "^4.10.2",
    "ramda": "^0.32.0",
    "rollup": "^4.64.0",
    "rollup-plugin-typescript2": "^0.37.0",
    "tslib": "^2.8.1",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
